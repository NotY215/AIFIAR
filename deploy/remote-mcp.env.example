# Set these in your deployment secret manager, not in source control.
AIFIAR_REMOTE_PUBLIC_URL=https://mcp.example.com/mcp
AIFIAR_REMOTE_PATH=/mcp
AIFIAR_REMOTE_HOST=0.0.0.0
AIFIAR_REMOTE_PORT=8787
AIFIAR_REMOTE_ALLOWED_HOSTS=mcp.example.com
# Optional browser origins. Leave empty for server-to-server-only integrations.
AIFIAR_REMOTE_ALLOWED_ORIGINS=
AIFIAR_REMOTE_MAX_BODY_BYTES=1048576
AIFIAR_REMOTE_MAX_REQUESTS_PER_MINUTE=120
# Generate a random token using:
# node scripts/generate-connector-token.mjs --profile=gpt --subject=your-user-id
# Store the resulting JSON array as AIFIAR_REMOTE_TOKENS in your secret manager.
AIFIAR_REMOTE_TOKENS=

# Optional external OAuth/OIDC resource-server validation. Configure all three together.
AIFIAR_OIDC_ISSUER=
AIFIAR_OIDC_AUDIENCE=
AIFIAR_OIDC_JWKS_URL=
AIFIAR_OIDC_JWKS_CACHE_MS=300000
