{
  "name": "aifiar",
  "version": "0.1.0",
  "private": false,
  "description": "Artificial Intelligence Framework for Interpretation and Reasoning",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:python": "python -m unittest discover -s python_tests -v",
    "test:all": "npm test && npm run test:python"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^22.15.30"
  },
  "engines": {
    "node": ">=20"
  }
}
